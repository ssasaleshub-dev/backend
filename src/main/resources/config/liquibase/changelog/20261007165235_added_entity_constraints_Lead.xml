<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Lead.
    -->
    <changeSet id="20261007165235-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="customer_id"
                                 baseTableName="lead"
                                 constraintName="fk_lead__customer_id"
                                 referencedColumnNames="id"
                                 referencedTableName="customer"
                                 />

        <addForeignKeyConstraint baseColumnNames="ad_id"
                                 baseTableName="lead"
                                 constraintName="fk_lead__ad_id"
                                 referencedColumnNames="id"
                                 referencedTableName="ad"
                                 />

        <addForeignKeyConstraint baseColumnNames="lead_form_id"
                                 baseTableName="lead"
                                 constraintName="fk_lead__lead_form_id"
                                 referencedColumnNames="id"
                                 referencedTableName="lead_form"
                                 />
    </changeSet>
</databaseChangeLog>

<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261121230000-1" author="salescrm">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="staff_biometric_credentials"/>
            </not>
        </preConditions>
        <createTable tableName="staff_biometric_credentials">
            <column name="id" type="bigint" autoIncrement="true" startWith="1000">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="user_name" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="device_id" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="device_name" type="varchar(150)">
                <constraints nullable="true"/>
            </column>
            <column name="biometric_key_id" type="varchar(500)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(50)" defaultValue="PENDING_APPROVAL">
                <constraints nullable="false"/>
            </column>
            <column name="is_locked" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="locked_at" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="locked_by" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
            tableName="staff_biometric_credentials"
            columnNames="user_id, device_id"
            constraintName="ux_biometric_credentials__user_device"/>

        <createIndex tableName="staff_biometric_credentials" indexName="idx_biometric_credentials__user_id">
            <column name="user_id"/>
        </createIndex>

        <createIndex tableName="staff_biometric_credentials" indexName="idx_biometric_credentials__status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
